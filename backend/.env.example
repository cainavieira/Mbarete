# Copie para backend/.env e preencha. O .env não entra no git
# (convencoes-backend.md, Configuração).
MBARETE_DB_URL=jdbc:postgresql://localhost:5434/mbarete
MBARETE_DB_USUARIO=mbarete
MBARETE_DB_SENHA=
# A chave privada do token de acesso, RSA em PKCS#8, em base64 numa linha só
# (ADR-0041). Só a api a exige; os modos migrar e convidar sobem sem ela.
MBARETE_JWT_CHAVE=
